# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Backend API ──
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Identidad de la empresa operadora ──
# Defaults a CADINC SRL si no se setean (ver src/lib/config/empresa.ts).
# Para deployar la instancia de OTRA empresa (modelo silo), setear estas tres
# y subir su logo a public/ (o apuntar NEXT_PUBLIC_EMPRESA_LOGO a una URL).
NEXT_PUBLIC_EMPRESA_NOMBRE=CADINC SRL
NEXT_PUBLIC_EMPRESA_CUIT=33-71719194-9
# Logo para fondo oscuro (login, selector) y para papel (OP, remitos). En
# CADINC NO hace falta setearlas: el default ya apunta a public/marca/.
NEXT_PUBLIC_EMPRESA_LOGO=/marca/cadinc-oscuro.png
NEXT_PUBLIC_EMPRESA_LOGO_PAPEL=/marca/cadinc-color.png
NEXT_PUBLIC_EMPRESA_DOMICILIO=Maipú 396, Dpto. 3 — San Miguel de Tucumán, Tucumán
